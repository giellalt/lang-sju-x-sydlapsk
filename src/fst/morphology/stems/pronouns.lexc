!! Pronouns
!  --------
!! Pronouns in the Old Literary Southern Sámi language are words that may replace nouns or refer to participants in the conversation.

LEXICON Pronouns
!pronoun    Cases   ;

Personal ;
Demonstrative ;
!Determiner ;
!Relative ;
Reflexive ;
!Interrogative ;
!Indefinita ;


! Personal pronouns
! =================

LEXICON Personal
mon+Pron+Pers+Sg1:m  perssgN ;
mon+Pron+Pers+Du1:m  persdu ;
mon+Pron+Pers+Pl1:m  perspl ;
todn+Pron+Pers+Sg2:t  perssgDN ;
todn+Pron+Pers+Sg2+Gen:aldat # ;
todn+Pron+Pers+Du2:t  persdu ;
todn+Pron+Pers+Pl2:t  perspl ;
sodn+Pron+Pers+Sg3:s  perssgDN ;
sodn+Pron+Pers+Sg3+Gen:alde # ;
sodn+Pron+Pers+Du3:s  persdu ;
sodn+Pron+Pers+Pl2:s  perspl ;



LEXICON perssgN
+Nom:on      # ;
perssg ;

LEXICON perssgDN
+Nom:odn      # ;
perssg ;


LEXICON perssg
+Acc:o      # ;
+Acc:onnob      # ;
+Gen:o      # ;
+Gen:un      # ;
+Ill:unji # ;
+Ine:usne # ;
+Ine:une # ;
+Ela:uste # ;
+Ela:ust # ;
+Com:uina # ;
+Com:uin # ;
+Ess:unjen # ;

LEXICON persdu
+Nom:åj # ;
+Gen:onno # ;
+Gen:onon # ;
+Gen:onnon # ;
+Acc:onob # ;
+Acc:onnob # ;
+Ill:onoi # ;
+Ill:onnoi # ;
+Ine:onon # ;
+Ela:onost # ;
+Com:onoin # ;
+Com:onnoin # ;
+Ess:onon # ;
+Ess:onnon # ;

LEXICON perspl
+Nom:ije # ;
+Gen:ija # ;
+Gen:ijan # ;
+Gen:ijen # ;
+Acc:ijab # ;
+Acc:ijeb # ;
+Ill:iji # ;
+Ine:ijan # ;
!+Ine:ijesne # ; !evidence?
+Ela:ijast # ;
+Ela:ijest # ;
+Com:ijain # ;
+Com:ijin # ;
+Ess:ijan # ;
+Ess:ijen # ;



! Demonstrative pronouns
! =================

LEXICON Demonstrative

! hic, den här
tat+Pron+Dem+Sg+Nom:tat # ;
tat+Pron+Dem+Sg+Gen:tan # ;
tat+Pron+Dem+Sg+Acc:tab # ;
tat+Pron+Dem+Sg+Acc:tabma # ;
tat+Pron+Dem+Sg+Ill:tassa # ;
tat+Pron+Dem+Sg+Ill:tas # ;
tat+Pron+Dem+Sg+Ine:tasne # ;
tat+Pron+Dem+Sg+Ine:tane # ;
tat+Pron+Dem+Sg+Ine:tanne # ;
tat+Pron+Dem+Sg+Ela:tast # ;
tat+Pron+Dem+Sg+Ela:taste # ;
tat+Pron+Dem+Sg+Ela:tate # ;
tat+Pron+Dem+Sg+Com:taina # ;
tat+Pron+Dem+Sg+Com:tain # ;
tat+Pron+Dem+Sg+Abe:tabta # ;

tat+Pron+Dem+Pl+Nom:tah # ;
tat+Pron+Dem+Pl+Gen:tai # ;
tat+Pron+Dem+Pl+Acc:tait # ;
tat+Pron+Dem+Pl+Acc:taite # ;
tat+Pron+Dem+Pl+Ill:tait # ;
tat+Pron+Dem+Pl+Ill:taite # ;
tat+Pron+Dem+Pl+Ill:taiti # ;
tat+Pron+Dem+Pl+Ine:taidne # ;
tat+Pron+Dem+Pl+Ine:taine # ;
tat+Pron+Dem+Pl+Ine:taisne # ;
tat+Pron+Dem+Pl+Ela:taiste # ;
tat+Pron+Dem+Pl+Ela:taist # ;
tat+Pron+Dem+Pl+Com:tai # ;
!tat+Pron+Dem+Pl+Abe:?? # ;
!tat+Pron+Dem+Pl+Ess:?? # ;

tat+Pron+Dem+Ess:tan # ;



! Reflexive pronouns
! =================

LEXICON Reflexive
etj+Pron+Refl:etj refl ;
!etj+Pron+Refl:ald reflGEN ;
etj+Pron+Refl:allas reflILL ;


LEXICON refl
+Sg+Gen+PxSg1:e%>n # ;
!+Sg+Gen+PxDu1:e%> # ;
+Sg+Gen+PxPl1:e%>ne # ;
+Sg+Acc+PxSg1:e%>m # ;
!+Sg+Acc+PxDu1:e%> # ;
+Sg+Acc+PxPl1:e%>me # ;
+Sg+Com+PxPl1:i%>nan # ;

+Sg+Nom+PxPl2:e%>teh # ;
+Sg+Gen+PxSg2:e%>t # ;
+Sg+Gen+PxPl2:e%>te # ;
+Sg+Acc+PxSg2:e%>bt # ;
+Sg+Acc+PxPl2:e%>bte # ;

+Sg+Gen+PxSg3:e%>s # ;
+Sg+Gen+PxDu3:e%>ska # ;
+Sg+Gen+PxPl3:e%>se # ;
!+Pl+Gen+PxSg3:e%>s # ;
+Pl+Gen+PxDu3:ei%>ska # ;
+Pl+Gen+PxPl3:ei%>sa # ;
+Sg+Acc+PxSg3:e%>bs # ;
+Sg+Acc+PxDu3:e%>bska # ;
+Sg+Acc+PxPl3:e%>bse # ;
+Sg+Acc+PxPl3:e%>bsa # ;
+Sg+Ine+PxPl3:ei%>snise # ;
+Sg+Ine+PxPl3:ei%>snase # ;
+Pl+Ine+PxPl3:i%>nase # ;
+Pl+Ine+PxPl3:ei%>nase # ;
+Sg+Ela+PxSg3:e%>stes # ;
+Sg+Ela+PxSg3:e%>stas # ;
+Sg+Com+PxPl3:ei%>nis # ;


LEXICON reflGEN
+Sg+Gen+PxSg2:a%>t # ;
+Sg+Gen+PxSg3:e # ;

LEXICON reflILL
+Sg+Ill+PxSg1:a%>n # ;
!+Sg+Ill+PxDu1:?%> # ;
+Sg+Ill+PxPl1:e%>ne # ;
+Sg+Ill+PxPl1:e%>me # ;
+Sg+Ill+PxPl1:a%>ni # ;

+Sg+Ill+PxSg2:a%>t # ;
+Sg+Ill+PxPl2:a%>te # ;
!+Sg+Ill+PxDu2:?%> # ;
!+Sg+Ill+PxDu3:?%> # ;

+Sg+Ill+PxSg3:a%>s # ;
+Sg+Ill+PxDu3:e%>ska # ;
+Sg+Ill+PxPl3:a%>se # ;
+Sg+Ill+PxPl3:e%>sa # ;


! vim: set ft=xfst-lexc:

!mah  nominat. plur. pron. mi, qui, quæ, vilka. Mah kirjit leh tah? quinam hi sunt libri? vilka böcker är dessa? It. 
!mai  quidem, väl, äntligen. Kullib mai, audiebam quidem, jag hörde väl äntligen. Påti mai, veniebat quidem. 
!massas  quem in finem, quare, till vad ända, varför. Massas le tatt? cui fini inserviet istud? vartill skall det vara? Jmf. pron. mi. Även 
!matte  est priv. casus pronom. mi. Matte landast todn påtah? ex qua regione venis? ifrån vilket land kommer du? Matte palest leh todn tab wuorkem? inde a quo tempore hoc reservasti? Matte merest kalkab alget? unde incipiam? It. 


